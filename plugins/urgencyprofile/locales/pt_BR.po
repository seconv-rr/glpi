#: src/Destination/UrgencyByProfileField.php
#: src/QuestionType/UrgencyByProfile.php
msgid "Urgency (restricted by profile)"
msgstr "Urgência (restrita por perfil)"

#: src/QuestionType/UrgencyByProfile.php
msgid ""
"No profile is allowed to answer this question: everyone gets the default "
"value above."
msgstr ""
"Nenhum perfil pode responder esta pergunta: todos recebem o valor padrão "
"acima."

#: src/QuestionType/UrgencyByProfile.php
msgid ""
"Only these profiles see this question: %s. Every other profile gets the "
"default value above."
msgstr ""
"Somente estes perfis veem esta pergunta: %s. Todos os outros perfis recebem "
"o valor padrão acima."

#: src/Destination/UrgencyByProfileField.php
msgid "Do not set the urgency"
msgstr "Não definir a urgência"

#: src/Destination/UrgencyByProfileField.php
msgid "Answer to the last restricted urgency question"
msgstr "Resposta da última pergunta de urgência restrita"
